;;; -*- mode: lisp-data -*-
;; The MELPA recipe for PEARL.  This file is copied verbatim into MELPA's
;; `recipes/pearl' by the pull request that publishes the package.
;;
;; `lisp/*.el' is what MELPA's builder flattens into the package root: the
;; installed package is one directory of modules, so `(require 'pearl-loop)'
;; resolves after installation the same way it does in this checkout.  `test/'
;; is absent on purpose -- a test module is not published.
(pearl
 :fetcher github
 :repo "OverbearingPearl/pearl"
 :files ("pearl.el" "lisp/*.el"))
